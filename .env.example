# Copy this file to .env and fill in real values before running in production.

# Any long random string — used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on.
PORT=3000

# Optional: where data/db.json is stored. Set this to your platform's
# persistent volume mount path in production (e.g. Railway: /data) so the
# database survives restarts and redeploys. Leave unset for local dev.
# DATA_DIR=/data
